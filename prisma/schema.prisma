generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  SALES
  OPERATIONS
  CONTENT
}

enum RequestType {
  MOTORCYCLE
  CAR
  TOUR
  GROUP
  CONTACT
}

enum RequestStatus {
  NEW
  UNDER_REVIEW
  MORE_INFO
  QUOTED
  HOLD
  CONFIRMED
  DECLINED
  COMPLETED
  CANCELLED
}

enum PublicStatus {
  AVAILABLE
  LIMITED
  ON_REQUEST
  UNAVAILABLE
}

enum CalendarBlockType {
  CONFIRMED
  HOLD
  MAINTENANCE
  UNAVAILABLE
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         Role          @default(SALES)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  assigned     Enquiry[]     @relation("Assigned")
  notes        EnquiryNote[]
}

model Motorcycle {
  id               String           @id @default(cuid())
  slug             String           @unique
  model            String
  unitCount        Int              @default(12)
  specs            Json
  recommendedUse   Json
  equipment        Json
  optionalServices Json
  priceNote        String
  depositNote      String
  publicStatus     PublicStatus     @default(AVAILABLE)
  images           Json
  published        Boolean          @default(true)
  units            MotorcycleUnit[]
}

model MotorcycleUnit {
  id                String          @id @default(cuid())
  motorcycleId      String
  motorcycle        Motorcycle      @relation(fields: [motorcycleId], references: [id], onDelete: Cascade)
  unitNumber        String
  registration      String?
  mileage           Int             @default(0)
  maintenanceStatus String          @default("ready")
  active            Boolean         @default(true)
  blocks            CalendarBlock[]

  @@unique([motorcycleId, unitNumber])
}

model Vehicle {
  id               String          @id @default(cuid())
  slug             String          @unique
  category         String
  make             String
  model            String
  year             Int
  transmission     String
  driveType        String
  fuel             String
  passengers       Int
  luggage          String
  routeSuitability Json
  serviceOptions   Json
  priceNote        String
  depositNote      String
  minDays          Int             @default(3)
  publicStatus     PublicStatus    @default(AVAILABLE)
  images           Json
  published        Boolean         @default(true)
  blocks           CalendarBlock[]
}

model Tour {
  id               String   @id @default(cuid())
  slug             String   @unique
  type             String
  title            Json
  summary          Json
  durationDays     Int
  dates            Json
  groupSize        String
  vehicleType      String
  difficulty       String
  distanceKm       Int
  dailyRidingHours String
  highestAltitude  Int
  surface          Json
  itinerary        Json
  inclusions       Json
  exclusions       Json
  priceBasis       Json
  images           Json
  published        Boolean  @default(true)
}

model RoutePage {
  id            String  @id @default(cuid())
  slug          String  @unique
  title         Json
  summary       Json
  startFinish   Json
  season        Json
  roadConditions Json
  experience    Json
  permits       Json
  supportOptions Json
  images        Json
  published     Boolean @default(true)
}

model Faq {
  id        String  @id @default(cuid())
  category  String
  question  Json
  answer    Json
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model Enquiry {
  id           String        @id @default(cuid())
  reference    String        @unique
  type         RequestType
  status       RequestStatus @default(NEW)
  locale       String        @default("en")
  payload      Json
  documents    Json?
  assignedToId String?
  assignedTo   User?         @relation("Assigned", fields: [assignedToId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  notes        EnquiryNote[]
}

model EnquiryNote {
  id        String   @id @default(cuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model CalendarBlock {
  id               String            @id @default(cuid())
  type             CalendarBlockType
  startDate        DateTime
  endDate          DateTime
  notes            String?
  motorcycleUnitId String?
  motorcycleUnit   MotorcycleUnit?   @relation(fields: [motorcycleUnitId], references: [id], onDelete: Cascade)
  vehicleId        String?
  vehicle          Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Setting {
  id   String @id @default("site")
  data Json
}
